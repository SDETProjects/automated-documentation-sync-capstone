{
  "mcpServers": {
    "docsync-jira": {
      "command": "python",
      "args": ["-m", "documentation_sync.jira_mcp_server"],
      "env": {
        "PYTHONPATH": "src",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "toolName": "Bash",
        "script": "hooks/block-secrets.py",
        "description": "Prevent secret writes via bash commands"
      },
      {
        "toolName": "Write",
        "script": "hooks/guard-generated-files.py",
        "description": "Protect .claude/ config from accidental overwrites"
      },
      {
        "toolName": "Edit",
        "script": "hooks/guard-generated-files.py",
        "description": "Protect .claude/ config from accidental overwrites"
      }
    ],
    "Stop": [
      {
        "script": "hooks/trigger-doc-sync.py",
        "description": "Block exit if src/ changed but docs not synced"
      }
    ]
  },
  "permissions": {
    "allowlist": [
      "Bash:find",
      "Bash:git",
      "Bash:npm",
      "Bash:python",
      "Bash:pytest",
      "Read:**",
      "Write:claude-*.md",
      "Write:.claude/**",
      "Write:src/**",
      "Write:tests/**",
      "Edit:claude-*.md",
      "Edit:src/**",
      "Edit:tests/**"
    ]
  }
}
